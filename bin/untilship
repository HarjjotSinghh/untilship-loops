#!/usr/bin/env node
/*
 * untilship: install loops into a repo and (optionally) drive them headlessly.
 *
 *   untilship list
 *   untilship pull [loop ...] --agent claude|codex|cursor [--dir .] [--all]
 *   untilship run <loop> --agent claude|codex|cursor [--agent-cmd "<cmd>"] [--set k=v ...] [--dir .]
 *   untilship remove [--agent claude|codex|cursor] [--dir .] [--keep-reports]
 *   untilship start|status|peek|abort ...      (same as untilship-check, run in --dir)
 *
 * Zero dependencies. MIT License.
 */
'use strict';

const fs = require('fs');
const path = require('path');
const cp = require('child_process');

const crypto = require('crypto');

const PKG_ROOT = path.resolve(__dirname, '..');
const DIST = path.join(PKG_ROOT, 'dist');
const engine = require('./untilship-check');
const AGENTS = ['claude', 'codex', 'cursor'];
const GITIGNORE = 'active.json\nlock/\nerrors.log\n*.tmp\n';
/** Where each agent's hook config and skills live (mirrors scripts/build-adapters.mjs). */
const HOOK_TARGET = { claude: '.claude/settings.json', codex: '.codex/hooks.json', cursor: '.cursor/hooks.json' };
const SKILL_DIR = { claude: '.claude/skills', codex: '.agents/skills', cursor: '.cursor/skills' };
/** What `pull` created, so `remove` can put the repo back exactly as it was. */
const INSTALL_RECORD = '.untilship/install.json';
const BLOCK_RE = /<!-- untilship:start -->[\s\S]*?<!-- untilship:end -->\n?/;
const sha256 = (s) => crypto.createHash('sha256').update(s).digest('hex');
const isObj = (v) => v !== null && typeof v === 'object' && !Array.isArray(v);
const canon = (v) => (Array.isArray(v) ? '[' + v.map(canon).join(',') + ']'
  : isObj(v) ? '{' + Object.keys(v).sort().map((k) => JSON.stringify(k) + ':' + canon(v[k])).join(',') + '}' : JSON.stringify(v));

function parseArgs(argv) {
  const a = { _: [], set: {} };
  for (let i = 0; i < argv.length; i++) {
    const x = argv[i];
    if (x === '--set') { const kv = argv[++i] || ''; const eq = kv.indexOf('='); if (eq < 1) throw new Error(`--set expects key=value, got "${kv}"`); a.set[kv.slice(0, eq)] = kv.slice(eq + 1); } else if (x.startsWith('--')) {
      const k = x.slice(2);
      if (['all', 'force', 'help', 'dry-run', 'keep-reports'].includes(k)) a[k] = true; else a[k] = argv[++i];
    } else a._.push(x);
  }
  return a;
}

function manifest() {
  const f = path.join(DIST, 'manifest.json');
  if (!fs.existsSync(f)) throw new Error('dist/manifest.json missing; run: node scripts/build-adapters.mjs');
  return JSON.parse(fs.readFileSync(f, 'utf8'));
}

function readJsonOrEmpty(file) {
  if (!fs.existsSync(file)) return {};
  const raw = fs.readFileSync(file, 'utf8');
  if (!raw.trim()) return {};
  try { return JSON.parse(raw); } catch (e) { throw new Error(`${file} is not valid JSON (${e.message}); fix it, then re-run pull. Nothing was changed.`); }
}

const isOurs = (cmd) => typeof cmd === 'string' && cmd.includes('untilship-check');

/** Merge the UntilShip stop hook into an agent's hook config, replacing any older UntilShip entry. */
function mergeHook(agent, existing, snippet) {
  const out = JSON.parse(JSON.stringify(existing || {}));
  out.hooks = out.hooks || {};
  if (agent === 'cursor') {
    out.version = out.version || 1;
    const cur = Array.isArray(out.hooks.stop) ? out.hooks.stop.filter((h) => !isOurs(h.command)) : [];
    out.hooks.stop = [...cur, ...snippet.hooks.stop];
  } else {
    const cur = Array.isArray(out.hooks.Stop) ? out.hooks.Stop
      .map((g) => ({ ...g, hooks: (g.hooks || []).filter((h) => !isOurs(h.command)) }))
      .filter((g) => g.hooks.length) : [];
    out.hooks.Stop = [...cur, ...snippet.hooks.Stop];
  }
  return out;
}

function copy(src, dst) {
  fs.mkdirSync(path.dirname(dst), { recursive: true });
  fs.copyFileSync(src, dst);
  try { if (fs.statSync(src).mode & 0o111) fs.chmodSync(dst, 0o755); } catch { /* windows */ }
}

/** Serialize JSON in the same indentation / trailing-newline style as `raw` (2 spaces + \n if new). */
function stringifyLike(obj, raw) {
  if (raw === null || raw === undefined) return JSON.stringify(obj, null, 2) + '\n';
  const m = /^[{[][ \t]*\r?\n([ \t]+)/.exec(raw);
  return JSON.stringify(obj, null, m ? m[1] : 2) + (raw.endsWith('\n') || !raw.trim() ? '\n' : '');
}

function readInstallRecord(dir) {
  try {
    const r = JSON.parse(fs.readFileSync(path.join(dir, INSTALL_RECORD), 'utf8'));
    return isObj(r) ? { version: 1, dirs: Array.isArray(r.dirs) ? r.dirs : [], files: isObj(r.files) ? r.files : {} } : null;
  } catch { return null; }
}

function pull(args) {
  const agent = args.agent;
  if (!AGENTS.includes(agent)) throw new Error(`--agent must be one of ${AGENTS.join(', ')}`);
  const m = manifest();
  const dir = path.resolve(args.dir || '.');
  const all = Object.keys(m.loops);
  const wanted = args.all || !args._.length ? all : args._;
  for (const w of wanted) if (!m.loops[w]) throw new Error(`unknown loop "${w}". Available: ${all.join(', ')}`);
  const a = m.agents[agent];
  const base = path.join(DIST, agent);
  const written = [];
  // validate hook config before writing anything
  const hookTarget = path.join(dir, a.hook.mergeInto);
  const hookRaw = fs.existsSync(hookTarget) ? fs.readFileSync(hookTarget, 'utf8') : null;
  const existingHook = readJsonOrEmpty(hookTarget);
  const merged = mergeHook(agent, existingHook, JSON.parse(fs.readFileSync(path.join(base, a.hook.file), 'utf8')));

  // install record: first pull wins for each file (it saw the original), dirs accumulate
  const record = readInstallRecord(dir) || { version: 1, dirs: [], files: {} };
  const dirs = new Set(record.dirs);
  const track = (relFile) => { // remember every directory outside .untilship/ that this pull creates
    const parts = relFile.split('/').slice(0, -1);
    for (let i = 1; i <= parts.length; i++) {
      const d = parts.slice(0, i).join('/');
      if (d === '.untilship' || d.startsWith('.untilship/')) return;
      if (!fs.existsSync(path.join(dir, d))) dirs.add(d);
    }
  };
  const ev = agent === 'cursor' ? 'stop' : 'Stop';
  if (!record.files[a.hook.mergeInto]) {
    const added = [];
    if (!isObj(existingHook.hooks)) added.push('hooks');
    if (!isObj(existingHook.hooks) || !(ev in existingHook.hooks)) added.push(`hooks.${ev}`);
    if (agent === 'cursor' && !('version' in existingHook)) added.push('version');
    // the original text lets `remove` restore the file byte for byte when nothing else changed
    record.files[a.hook.mergeInto] = hookRaw === null ? { created: true, added } : { created: false, added, original: hookRaw };
  }

  for (const f of a.common) {
    if (f === a.hook.file || f === 'AGENTS.untilship.md') continue;
    track(f); copy(path.join(base, f), path.join(dir, f)); written.push(f);
  }
  for (const w of wanted) for (const f of a.loops[w]) { track(f); copy(path.join(base, f), path.join(dir, f)); written.push(f); }
  track(a.hook.mergeInto);
  fs.mkdirSync(path.dirname(hookTarget), { recursive: true });
  fs.writeFileSync(hookTarget, stringifyLike(merged, hookRaw));
  written.push(`${a.hook.mergeInto} (merged Stop hook)`);
  if (a.common.includes('AGENTS.untilship.md')) {
    const agentsMd = path.join(dir, 'AGENTS.md');
    const block = fs.readFileSync(path.join(base, 'AGENTS.untilship.md'), 'utf8');
    const exists = fs.existsSync(agentsMd);
    const cur = exists ? fs.readFileSync(agentsMd, 'utf8') : '';
    const hasBlock = BLOCK_RE.test(cur);
    if (!hasBlock && !record.files['AGENTS.md']) record.files['AGENTS.md'] = { created: !exists, sha256: exists ? sha256(cur) : null };
    const next = hasBlock ? cur.replace(BLOCK_RE, block) : (cur ? cur.replace(/\n*$/, '\n\n') : '') + block;
    fs.writeFileSync(agentsMd, next);
    written.push('AGENTS.md (UntilShip section)');
  }
  const gi = path.join(dir, '.untilship', '.gitignore');
  if (!fs.existsSync(gi)) { fs.writeFileSync(gi, GITIGNORE); written.push('.untilship/.gitignore'); }
  record.dirs = Array.from(dirs).sort();
  fs.writeFileSync(path.join(dir, INSTALL_RECORD), JSON.stringify(record, null, 2) + '\n');
  return { dir, agent, loops: wanted, written };
}

/* ------------------------------------------------------------------ */
/* remove                                                              */
/* ------------------------------------------------------------------ */

const hasOurHook = (agent, obj) => {
  const ev = agent === 'cursor' ? 'stop' : 'Stop';
  const list = isObj(obj) && isObj(obj.hooks) && Array.isArray(obj.hooks[ev]) ? obj.hooks[ev] : [];
  return agent === 'cursor'
    ? list.some((h) => h && isOurs(h.command))
    : list.some((g) => g && Array.isArray(g.hooks) && g.hooks.some((h) => h && isOurs(h.command)));
};

/**
 * Take UntilShip's stop hook out of a hook config, leaving every other hook and key alone.
 * `rec` (from the install record) says which containers UntilShip added; without it, only
 * containers left empty by the removal are dropped.
 */
function unmergeHook(agent, existing, rec) {
  const out = JSON.parse(JSON.stringify(existing));
  const ev = agent === 'cursor' ? 'stop' : 'Stop';
  if (!hasOurHook(agent, out)) return { changed: false, obj: out, empty: false };
  if (agent === 'cursor') {
    out.hooks.stop = out.hooks.stop.filter((h) => !(h && isOurs(h.command)));
  } else {
    out.hooks.Stop = out.hooks.Stop.map((g) => {
      if (!g || !Array.isArray(g.hooks)) return g;
      const hs = g.hooks.filter((h) => !(h && isOurs(h.command)));
      return hs.length === g.hooks.length ? g : (hs.length ? { ...g, hooks: hs } : null);
    }).filter((g) => g !== null);
  }
  const added = rec && Array.isArray(rec.added) ? rec.added : null;
  if (!out.hooks[ev].length && (!added || added.includes(`hooks.${ev}`))) delete out.hooks[ev];
  if (!Object.keys(out.hooks).length && (!added || added.includes('hooks'))) delete out.hooks;
  const ourVersion = agent === 'cursor' && (added ? added.includes('version') : true);
  if (ourVersion && added && 'version' in out) delete out.version;
  const rest = Object.keys(out).filter((k) => !(ourVersion && k === 'version' && out.version === 1));
  return { changed: true, obj: out, empty: rest.length === 0 };
}

function rmrf(p) { fs.rmSync(p, { recursive: true, force: true }); }

function remove(args) {
  const dir = path.resolve(args.dir || '.');
  if (args.agent !== undefined && !AGENTS.includes(args.agent)) throw new Error(`--agent must be one of ${AGENTS.join(', ')}`);
  const agents = args.agent ? [args.agent] : AGENTS;
  const record = readInstallRecord(dir);
  const removed = [];
  const notes = [];

  for (const agent of agents) {
    // 1. skills: every untilship-* folder in the agent's skill dir
    const sd = path.join(dir, SKILL_DIR[agent]);
    let ents = [];
    try { ents = fs.readdirSync(sd, { withFileTypes: true }); } catch { /* none */ }
    for (const e of ents.filter((x) => x.isDirectory() && x.name.startsWith('untilship-')).sort((x, y) => x.name.localeCompare(y.name))) {
      rmrf(path.join(sd, e.name));
      removed.push(`${SKILL_DIR[agent]}/${e.name}/`);
    }
    // 2. the Stop hook entry
    const target = HOOK_TARGET[agent];
    const abs = path.join(dir, target);
    if (!fs.existsSync(abs)) continue;
    const raw = fs.readFileSync(abs, 'utf8');
    let obj;
    try { obj = raw.trim() ? JSON.parse(raw) : {}; } catch {
      notes.push(`${target} is not valid JSON; left untouched (remove the untilship-check hook by hand)`);
      continue;
    }
    const rec = record && record.files[target];
    const res = unmergeHook(agent, obj, rec);
    if (!res.changed) continue;
    if (res.empty && (!rec || rec.created)) {
      fs.rmSync(abs, { force: true });
      removed.push(target);
    } else {
      let original = null;
      try { if (rec && typeof rec.original === 'string' && canon(JSON.parse(rec.original)) === canon(res.obj)) original = rec.original; } catch { /* use res.obj */ }
      fs.writeFileSync(abs, original !== null ? original : stringifyLike(res.obj, raw));
      removed.push(`${target} (UntilShip Stop hook entry; other hooks and keys kept)`);
    }
    if (record) delete record.files[target];
  }

  // Shared parts go only when no other agent's UntilShip hook is still installed.
  const stillUsing = AGENTS.filter((ag) => !agents.includes(ag)).filter((ag) => {
    try { return hasOurHook(ag, JSON.parse(fs.readFileSync(path.join(dir, HOOK_TARGET[ag]), 'utf8'))); } catch { return false; }
  });

  // 3. the marked AGENTS.md block (written for codex/cursor)
  const agentsMd = path.join(dir, 'AGENTS.md');
  if (!stillUsing.some((ag) => ag !== 'claude') && fs.existsSync(agentsMd)) {
    const cur = fs.readFileSync(agentsMd, 'utf8');
    const m = BLOCK_RE.exec(cur);
    if (m) {
      const rec = record && record.files['AGENTS.md'];
      let next = cur.slice(0, m.index) + cur.slice(m.index + m[0].length);
      if (m.index + m[0].length >= cur.length) { // block was last: undo the blank line pull added before it
        const body = next.replace(/\n*$/, '');
        const candidates = [body + '\n', body, body + '\n\n', body + '\n\n\n'];
        next = (rec && rec.sha256 && candidates.find((c) => sha256(c) === rec.sha256)) || (body ? body + '\n' : '');
      }
      if (!next.trim() && (!rec || rec.created)) {
        fs.rmSync(agentsMd, { force: true });
        removed.push('AGENTS.md');
      } else {
        fs.writeFileSync(agentsMd, next);
        removed.push('AGENTS.md (UntilShip section; the rest kept)');
      }
      if (record) delete record.files['AGENTS.md'];
    }
  }

  // 4. directories pull created (or, without a record, the agents' own dirs) if now empty
  const candidates = record ? record.dirs : ['.claude/skills', '.claude', '.agents/skills', '.agents', '.cursor/skills', '.cursor', '.codex'];
  for (const d of candidates.slice().sort((x, y) => y.split('/').length - x.split('/').length || y.localeCompare(x))) {
    const p = path.join(dir, d);
    try { if (fs.statSync(p).isDirectory() && !fs.readdirSync(p).length) { fs.rmdirSync(p); removed.push(`${d}/`); } } catch { /* gone */ }
  }

  // 5. .untilship/
  const state = path.join(dir, '.untilship');
  if (fs.existsSync(state)) {
    if (stillUsing.length) {
      notes.push(`kept .untilship/ (still used by: ${stillUsing.join(', ')})`);
      if (record) fs.writeFileSync(path.join(dir, INSTALL_RECORD), JSON.stringify(record, null, 2) + '\n');
    } else if (args['keep-reports'] && fs.existsSync(path.join(state, 'runs'))) {
      for (const e of fs.readdirSync(state).sort()) {
        if (e === 'runs') continue;
        const p = path.join(state, e);
        const isDir = fs.statSync(p).isDirectory();
        rmrf(p);
        removed.push(`.untilship/${e}${isDir ? '/' : ''}`);
      }
      notes.push('kept .untilship/runs/ (--keep-reports)');
    } else {
      rmrf(state);
      removed.push('.untilship/');
    }
  }
  return { dir, agents, removed, notes };
}

/** Split a command template into argv, honouring simple quotes. */
function splitCmd(s) {
  const out = []; let cur = ''; let q = null; let any = false;
  for (const c of String(s)) {
    if (q) { if (c === q) q = null; else cur += c; continue; }
    if (c === '"' || c === "'") { q = c; any = true; continue; }
    if (/\s/.test(c)) { if (cur || any) { out.push(cur); cur = ''; any = false; } continue; }
    cur += c;
  }
  if (cur || any) out.push(cur);
  return out;
}

const DEFAULT_AGENT_CMD = {
  claude: 'claude -p --permission-mode acceptEdits',
  codex: 'codex exec --sandbox workspace-write',
  cursor: 'cursor-agent -p --force',
};

function firstPrompt(run, loopBody) {
  return [
    `You are running the UntilShip loop "${run.config.title}" (run ${run.runId}).`,
    'Follow the loop below. A script checks the stop condition after you finish; you cannot declare success.',
    'Do not edit .untilship/, hook config, or the protected files listed in the loop. When you believe the check passes, finish.',
    `Stop condition: ${run.config.checks.join(' && ')}`,
    '',
    loopBody.trim(),
  ].join('\n');
}

function runLoop(args) {
  const ref = args._[0];
  if (!ref) throw new Error('run needs a loop name');
  const agent = args.agent;
  if (!args['agent-cmd'] && !AGENTS.includes(agent)) throw new Error(`--agent must be one of ${AGENTS.join(', ')} (or pass --agent-cmd)`);
  const dir = path.resolve(args.dir || '.');
  const st = engine.status(dir);
  let run;
  if (st.active) {
    if (st.loop !== path.basename(ref)) throw new Error(`another loop is active (${st.loop}); abort it first`);
    run = JSON.parse(fs.readFileSync(path.join(dir, '.untilship', 'runs', st.runId, 'run.json'), 'utf8'));
  } else {
    run = engine.start(dir, ref, { vars: args.set, agent: `runner:${agent || 'custom'}` });
  }
  const loopFile = path.join(dir, run.config.loopFile);
  const body = engine.parseFrontmatter(fs.readFileSync(loopFile, 'utf8')).body;
  const argv = splitCmd(args['agent-cmd'] || DEFAULT_AGENT_CMD[agent]);
  let prompt = firstPrompt(run, body);
  const log = (s) => process.stderr.write(`[untilship] ${s}\n`);
  let lapsRun = run.laps.length;
  log(`run ${run.runId}: "${run.config.name}", up to ${run.config.maxLaps} laps, agent: ${argv.join(' ')}`);
  for (;;) {
    const r = cp.spawnSync(argv[0], [...argv.slice(1), prompt], {
      cwd: dir, stdio: ['ignore', 'inherit', 'inherit'], shell: process.platform === 'win32',
      env: Object.assign({}, process.env, { UNTILSHIP_RUNNER: '1' }),
    });
    if (r.error) throw new Error(`could not start agent "${argv[0]}": ${r.error.message}`);
    if (r.status !== 0) log(`agent exited ${r.status}; checking anyway`);
    // every lap after the first is a re-entry: the agent was sent back by the check
    const d = engine.evaluate(dir, { agent: 'runner', input: { stop_hook_active: lapsRun > 0 } });
    lapsRun++;
    if (d.action === 'allow') { log(d.message || d.status); return d.status === 'passed' ? 0 : 3; }
    log(`lap ${d.lap} failed; re-invoking the agent`);
    prompt = `${d.reason}\n\nContinue the loop. The original instructions are in ${run.config.loopFile}.`;
  }
}

const HELP = `untilship: agent loops with a stop condition enforced outside the model.

  untilship list                                   loops in this package
  untilship pull [loop ...] --agent <a> [--dir .]  install loops + stop hook (default: all free loops)
  untilship remove [--agent <a>] [--dir .] [--keep-reports]
                                                   uninstall: skills, UntilShip's hook entry, AGENTS.md block,
                                                   .untilship/ (--keep-reports keeps .untilship/runs/)
  untilship run <loop> --agent <a> [--agent-cmd "<cmd>"] [--set k=v] [--dir .]
                                                   headless runner: re-invokes the agent until the check passes
  untilship start|status|peek|abort|eval ...       passthrough to untilship-check (in --dir)
Agents: ${AGENTS.join(', ')}`;

function main(argv) {
  let a;
  try { a = parseArgs(argv); } catch (e) { process.stderr.write(e.message + '\n'); return 2; }
  const cmd = a._.shift();
  try {
    if (!cmd || a.help || cmd === 'help') { process.stdout.write(HELP + '\n'); return cmd ? 0 : 2; }
    if (cmd === 'list') {
      const m = manifest();
      for (const [slug, l] of Object.entries(m.loops)) process.stdout.write(`${slug.padEnd(20)} ${String(l.tier).padEnd(7)} ${l.type.padEnd(8)} stop when ${l.stopWhen}\n`);
      return 0;
    }
    if (cmd === 'pull') {
      const r = pull(a);
      process.stdout.write(`Installed ${r.loops.length} loop(s) for ${r.agent} into ${r.dir}:\n${r.written.map((w) => '  ' + w).join('\n')}\n` +
        `Next: open the repo in ${r.agent} and invoke /untilship-<loop>. Commit .untilship/ (runs/ holds reports).\n`);
      return 0;
    }
    if (cmd === 'remove' || cmd === 'uninstall') {
      const r = remove(a);
      if (!r.removed.length) process.stdout.write(`Nothing to remove: no UntilShip files for ${r.agents.join(', ')} in ${r.dir}.\n`);
      else process.stdout.write(`Removed from ${r.dir}:\n${r.removed.map((x) => '  ' + x).join('\n')}\n`);
      for (const n of r.notes) process.stdout.write(`Note: ${n}\n`);
      return 0;
    }
    if (cmd === 'run') return runLoop(a);
    if (['start', 'status', 'peek', 'abort', 'eval', 'hook'].includes(cmd)) {
      const rest = argv.slice(argv.indexOf(cmd) + 1).filter((x, i, arr) => x !== '--dir' && arr[i - 1] !== '--dir');
      return engine.main([cmd, ...rest, '--root', path.resolve(a.dir || '.')]);
    }
  } catch (e) {
    process.stderr.write(`untilship: ${e.message}\n`);
    return 2;
  }
  process.stderr.write(HELP + '\n');
  return 2;
}

module.exports = { pull, remove, mergeHook, unmergeHook, stringifyLike, splitCmd, runLoop, main };

if (require.main === module) process.exitCode = main(process.argv.slice(2));
